% Pandoc LaTeX template that follows the layout of the official Apart sprint report template
% (Google Doc linked from the sprint page): title between rules, centred authors, "With Apart Research",
% centred abstract, numbered sans-serif headings, Old Standard body text.
\documentclass[11pt]{article}
\usepackage[letterpaper,margin=1in]{geometry}
\usepackage{fontspec}
\setmainfont{OldStandard}[Extension=.otf, UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, Ligatures=TeX]
\setsansfont{texgyreheros}[Extension=.otf, UprightFont=*-regular, BoldFont=*-bold, ItalicFont=*-italic, BoldItalicFont=*-bolditalic]
\setmonofont{Menlo}[Scale=0.78]
\usepackage{xcolor}
\definecolor{apartgrey}{HTML}{434343}
\definecolor{linkblue}{HTML}{0B5394}
\usepackage{graphicx}
\usepackage{booktabs,longtable,array,calc}
\newcounter{none}
\usepackage[font=small,labelformat=empty,skip=4pt]{caption}
\usepackage{float}
\makeatletter\def\fps@figure{!htbp}\makeatother
\renewcommand{\topfraction}{0.9}\renewcommand{\textfraction}{0.08}\renewcommand{\floatpagefraction}{0.85}
\setcounter{secnumdepth}{0}
\usepackage{titlesec}
\titleformat{\section}{\sffamily\bfseries\large}{}{0pt}{}
\titleformat{\subsection}{\sffamily\bfseries\normalsize\color{apartgrey}}{}{0pt}{}
\titleformat{\subsubsection}{\sffamily\bfseries\small\color{apartgrey}}{}{0pt}{}
\titlespacing*{\section}{0pt}{12pt plus 2pt minus 2pt}{4pt}
\titlespacing*{\subsection}{0pt}{8pt plus 2pt minus 1pt}{3pt}
\titlespacing*{\subsubsection}{0pt}{6pt plus 1pt}{2pt}
\usepackage{enumitem}
\setlist{itemsep=1pt,topsep=3pt,leftmargin=*}
\setlength{\parindent}{0pt}
\setlength{\parskip}{4.5pt plus 1pt}
\linespread{1.04}
\usepackage{microtype}
\usepackage{fancyhdr}
\pagestyle{fancy}\fancyhf{}\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\sffamily\footnotesize\thepage}
\usepackage[hidelinks]{hyperref}
\hypersetup{colorlinks=true,linkcolor=linkblue,urlcolor=linkblue,citecolor=linkblue,pdftitle={$title-meta$},pdfauthor={$author-meta$}}
\usepackage{xurl}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{% scale an image down to fit the text width and height
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}\else\usebox{\pandoc@box}\fi}
\makeatother
\renewcommand{\arraystretch}{1.12}
\setlength{\LTpre}{3pt}\setlength{\LTpost}{6pt}
\begin{document}
\thispagestyle{fancy}
\begin{center}
{\rule{\textwidth}{1.6pt}}\\[8pt]
{\sffamily\bfseries\LARGE $title$\par}
\vspace{6pt}{\rule{\textwidth}{0.5pt}}\\[10pt]
{\sffamily\normalsize $authors$\par}
\vspace{6pt}
{\sffamily\small\textbf{With}\\ Apart Research\par}
\vspace{4pt}
{\sffamily\footnotesize $affil$\par}
\end{center}
\vspace{2pt}
\begin{center}{\sffamily\bfseries\large Abstract}\end{center}
\vspace{-4pt}
\begin{quote}\small
$abstract$
\end{quote}
\vspace{4pt}
$body$
\end{document}
